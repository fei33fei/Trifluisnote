{
  "name": "trifluisnote",
  "version": "0.1.0",
  "description": "Trifluisnote — 一个所见即所得的 Markdown 桌面编辑器",
  "main": "./out/main/index.js",
  "author": "Fey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fei33fei/Trifluisnote.git"
  },
  "homepage": "https://github.com/fei33fei/Trifluisnote#readme",
  "bugs": {
    "url": "https://github.com/fei33fei/Trifluisnote/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --dir",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:nsis": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@milkdown/core": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@milkdown/preset-commonmark": "7.23.0",
    "@milkdown/react": "7.23.0",
    "@milkdown/theme-nord": "7.23.0",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.6.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
